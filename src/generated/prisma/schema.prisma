// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  // moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Role {
  USER
  ADMIN
  AGENT
  IT
}

enum MatchStatus {
  ACTIVE
  BROKEN
}

enum MatchType {
  BOOST
  NORMAL
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  LINK
  EMOJI
  GIFT
}

enum MessageStatus {
  UNSENT
  SENT // Un trait gris
  DELIVERED // Double trait gris
  READ // Double trait coloré
}

enum ChatLastMessageStatus {
  PENDING
  SENT
  UNSENT
  RECEIVED
  READ
}

enum VideoSessionStatus {
  AWAITING
  IN_CALL
  APPROVED
  REJECTED
  CANCELLED
}

enum GiftCategory {
  ROSE
  MODE_BEAUTE
  FITNESS_BIEN_ETRE
  CUISINE_GASTRONOMIE
  BIJOUX_ACCESSOIRES
  ART_CREATIVITE
  MUSIQUE
  TECHNOLOGIE_GADGET
  LITTERATURE_ECRITURE
  JARDINAGE
  JEUX_LOISIRS
  ADULT
  UNCLASSIFIED
}

enum PurchaseStatus {
  PENDING
  PROCESSING
  RECEIVED
  CANCELLED
}

enum VehicleType {
  MOTO
  BERLINE
  VIP
  MINIBUS
}

enum ActivityType {
  CONCERT
  RANDONNEE
  MATCH
  CINEMA
  BOWLING
  KARTING
  PLAGE
  HELICOPTERE
  LASER_GAME
  ESCAPE_GAME
  PISCINE
  EVENEMENT_SPECIAL
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  PROCESSED
  ON_TRIP
  CANCELLED
  LITIGE
}

enum PodiumCategory {
  NONE
  COUNTRY
  WORLD
}

enum PodiumStatus {
  NONE
  ACTIVE
  PASSED
}

enum SubscriptionType {
  HEBERGEMENT
  RESTAURANT
  TRANSPORT
  ACTIVITE
  CADEAU
  COFFRET
}

enum RetraitStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
}

enum AmbianceType {
  INTIME
  SEMI_PRIVE
  SALLE_PRINCIPALE
}

enum CompanyCategory {
  RESTAURANT
  HOTEL
  TRANSPORT
  ACTIVITY
  GIFT
  BEAUTY
  OTHER
}

enum TrancheType {
  RECHARGE
  ACHAT
  LUMIERE_ENVOI
  LUMIERE_RECEPTION
  AJUSTEMENT
}

enum TrancheStatus {
  ACTIVE
  EPUISE
  EXPIRE
}

enum EnvelopeType {
  DAILY
  MONTHLY
  YEARLY
}

// ======================================================
// CONFIGURATION DEVISES & PAYS
// ======================================================

model CurrencyConfig {
  id           Int      @id @default(autoincrement())
  countryCode  String   @unique
  currencyCode String
  symbol       String
  bonusRate    Decimal  @default(0.10) @db.Decimal(4, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ======================================================
// USER
// ======================================================

model User {
  id Int @id @default(autoincrement())

  // AUTH
  phoneNumber String  @unique
  passCode    String?

  // PROFILE
  fullname         String
  username         String? @unique
  email            String? @unique
  profilePhoto     String?
  firstOtherPhoto  String?
  secondOtherPhoto String?
  thirdOtherPhoto  String?

  birthday DateTime?
  gender   Gender?

  biography String?
  vision    String?
  passion   String?
  religion  String?
  horoscope String?

  languages   Json?
  preferences Json?

  // LOCATION
  country   String?
  city      String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // APP
  coins   Decimal @default(0) @db.Decimal(18, 2)
  dmScore Decimal @default(0) @db.Decimal(18, 2)

  isCertified        Boolean @default(false)
  isCompleted        Boolean @default(false)
  isFakeAccount      Boolean @default(false)
  isOnline           Boolean @default(false)
  isBanned           Boolean @default(false)
  isPhoneVerified    Boolean @default(false)
  isIdentityVerified Boolean @default(false)
  isVideoEnabled     Boolean @default(false)
  isLockEnabled      Boolean @default(false)
  onboardingStep     String  @default("GENERAL_INFO")
  deviceToken        String?

  // PROFILE UPDATE CONTROL
  lastProfileUpdated DateTime?
  lastPhotoUpdated   DateTime?

  // STAFF
  role            Role   @default(USER)
  assignedAgentId Int?
  assignedAgent   User?  @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  assignedUsers   User[] @relation("AssignedAgent")

  // WALLET CHRONOLOGIQUE
  walletTranches WalletTranche[]
  starpoints     StarpointWallet?

  // STATS
  podiumOccurenceCount Int @default(0)

  // RELATIONS
  permissions     Permission[] @relation("UserPermissions")
  preferredGiftId Int?
  preferredGift   Gift?        @relation("PreferredGift", fields: [preferredGiftId], references: [id], onDelete: SetNull)

  giftPurposeId Int?
  giftPurpose   Annonce? @relation("GiftPurpose", fields: [giftPurposeId], references: [id], onDelete: SetNull)

  videoSession         VideoSession?  @relation("UserVideoSession")
  managedVideoSessions VideoSession[] @relation("VideoAgent")

  sentMatches     Match[] @relation("MatchSender")
  receivedMatches Match[] @relation("MatchReceiver")

  sentNotifications     Notification[] @relation("NotificationSender")
  receivedNotifications Notification[] @relation("NotificationReceiver")

  socketMapping SocketMapping?

  initiatedLocks LockedConversation[] @relation("InitiatedLocks")
  receivedLocks  LockedConversation[] @relation("ReceivedLocks")

  // PODIUM RELATIONS HARMONISÉES
  podiumStarsLed     PodiumStar[]        @relation("UserAsPodiumStar")
  podiumViews        PodiumSpectator[]   @relation("UserAsPodiumSpectator")
  podiumTransactions PodiumTransaction[]

  dayStar   StarOfTheDay[]
  monthStar StarOfTheMonth[]
  yearStar  StarOfTheYear[]

  annonceLikes         LikedAnnonce[]
  reservations         Reservation[]
  receivedReservations Reservation[]  @relation("ReservationReceiver")

  sentPurchases     Purchase[] @relation("PurchaseSender")
  receivedPurchases Purchase[] @relation("PurchaseReceiver")

  userCompanies UserCompany[]
  userDmList    DmList[]
  sessions      UserSession[]

  blockedUsers   UserBlock[] @relation("Blocker")
  blockedByUsers UserBlock[] @relation("Blocked")

  reportsMade     UserReport[] @relation("Reporter")
  reportsReceived UserReport[] @relation("Reported")

  targetedAnnonces Annonce[] @relation("AnnonceTargets")

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  coffretReservations CoffretReservation[]
  chatRoomsAsOne      ChatRoom[]           @relation("ChatParticipantOne")
  chatRoomsAsTwo      ChatRoom[]           @relation("ChatParticipantTwo")

  sentMessages        Message[]            @relation("SentMessages")
  receivedMessages    Message[]            @relation("ReceivedMessages")
  envelopeWinners     EnvelopeWinner[]
  userEnvelopeMetrics UserEnvelopeMetric[]

  @@index([phoneNumber])
  @@index([role])
  @@index([country])
  @@index([city])
  @@index([isCompleted])
  @@index([createdAt])
}

// ======================================================
// AUTH
// ======================================================

model OtpVerification {
  id          Int      @id @default(autoincrement())
  phoneNumber String   @unique
  codeHash    String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model UserSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  refreshToken String   @unique
  deviceName   String?
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

// ======================================================
// PERMISSIONS
// ======================================================

model Permission {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  type        String?
  description String?
  users       User[]  @relation("UserPermissions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// VIDEO SESSION
// ======================================================

model VideoSession {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation("UserVideoSession", fields: [userId], references: [id], onDelete: Cascade)

  agentId Int?
  agent   User? @relation("VideoAgent", fields: [agentId], references: [id])

  roomId String             @unique
  status VideoSessionStatus @default(AWAITING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// MATCH
// ======================================================

model Match {
  id          Int         @id @default(autoincrement())
  fromId      Int
  toId        Int
  from        User        @relation("MatchSender", fields: [fromId], references: [id])
  to          User        @relation("MatchReceiver", fields: [toId], references: [id])
  isConfirmed Boolean     @default(false)
  type        MatchType   @default(NORMAL)
  status      MatchStatus @default(ACTIVE)

  flameExpiresAt DateTime?

  giftId Int?
  gift   Gift? @relation(fields: [giftId], references: [id], onDelete: SetNull)

  purchaseId Int?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  chatRoom ChatRoom?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([status])
  @@index([fromId, toId])
}

// ======================================================
// CHAT
// ======================================================

model ChatRoom {
  id               Int     @id @default(autoincrement())
  matchId          Int     @unique // Un seul salon de discussion par couple exclusif
  participantOneId Int
  participantTwoId Int
  isActive         Boolean @default(true) // Devient false lors d'un break-up

  participantOne User  @relation("ChatParticipantOne", fields: [participantOneId], references: [id])
  participantTwo User  @relation("ChatParticipantTwo", fields: [participantTwoId], references: [id])
  match          Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  lastMessage         String?               @db.VarChar(1000)
  lastMessageSenderId Int?
  lastMessageStatus   ChatLastMessageStatus @default(PENDING)
  isSentByAgent       Boolean               @default(false)
  agentId             Int?

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantOneId, participantTwoId])
  @@index([matchId])
}

model Message {
  id          Int @id @default(autoincrement())
  matchId     Int // Référence au couple
  chatRoomId  Int // Référence au salon physique
  senderId    Int
  recipientId Int

  type          MessageType   @default(TEXT)
  content       String        @db.Text // Texte, URL de l'image/audio, ou ID du cadeau
  status        MessageStatus @default(SENT)
  isSentByAgent Boolean       @default(false)

  chatRoom  ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  recipient User     @relation("ReceivedMessages", fields: [recipientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatRoomId])
  @@index([senderId])
  @@index([createdAt])
}

// ======================================================
// NOTIFICATION
// ======================================================

model Notification {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  fromUserId Int
  toUserId   Int
  from       User     @relation("NotificationSender", fields: [fromUserId], references: [id])
  to         User     @relation("NotificationReceiver", fields: [toUserId], references: [id])
  createdAt  DateTime @default(now())
}

// ======================================================
// GIFT
// ======================================================

model Gift {
  id          Int          @id @default(autoincrement())
  name        String
  price       Decimal      @db.Decimal(18, 2)
  points      Decimal      @default(1) @db.Decimal(18, 2)
  image       String
  description String?
  category    GiftCategory @default(UNCLASSIFIED)
  isAvailable Boolean      @default(true)
  expiresIn   Int          @default(30)

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  preferredByUsers User[] @relation("PreferredGift")

  matches   Match[]
  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// ANNONCE
// ======================================================

model Annonce {
  id          Int     @id @default(autoincrement())
  name        String
  price       Decimal @db.Decimal(18, 2) // Pour le transport, ce sera le tarif de base/au km ou estimé  
  points      Decimal @default(1) @db.Decimal(18, 2)
  image       String
  description String?
  category    String?
  isAvailable Boolean @default(true)
  isVerified  Boolean @default(false)
  isSpecial   Boolean @default(false)
  expiresIn   Int     @default(30)

  // Restaurant & Hébergement & Activités
  ambiance            AmbianceType? @default(SALLE_PRINCIPALE)
  hasAnimation        Boolean       @default(false)
  isDeliveryAvailable Boolean       @default(false)
  isRomantique        Boolean       @default(false)
  equipements         Json?

  // Spécifique Transport
  vehicleType VehicleType?
  nbPlaces    Int?

  // Spécifique Activités
  activityType ActivityType?

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  purchases    Purchase[]
  reservations Reservation[]
  likes        LikedAnnonce[]
  dmList       DmList[]

  giftPurposes User[] @relation("GiftPurpose")
  targetUsers  User[] @relation("AnnonceTargets")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isAvailable])
  @@index([vehicleType])
  @@index([activityType])
}

// ==========================================
// MODÈLE : COFFRET ROMANTIQUE (AUTONOME)
// ==========================================
model Coffret {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(255)
  description  String  @db.Text
  images       Json // Tableau d'URLs d'images pour le carrousel [url1, url2, ...]
  price        Decimal @db.Decimal(18, 2) // Prix unitaire global par personne
  durationDays Int     @default(2) // Durée globale (ex: 2 pour un week-end)
  isAvailable  Boolean @default(true)
  isVerified   Boolean @default(false) // Validation administrative (RG-01)
  isSpecial    Boolean @default(false) // Pour l'affichage en vedette

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items        CoffretItem[]
  reservations CoffretReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isAvailable, isVerified])
}

// ==========================================
// COMPOSANTS DE COFFRET (CONTENU TEXTUEL)
// ==========================================
model CoffretItem {
  id        Int     @id @default(autoincrement())
  coffretId Int
  coffret   Coffret @relation(fields: [coffretId], references: [id], onDelete: Cascade)

  category      CompanyCategory // RESTAURANT, HOTEL, TRANSPORT, ACTIVITY, GIFT
  name          String          @db.VarChar(255) // Ex: "Transfert en Berline VIP"
  description   String?         @db.Text // Ex: "Chauffeur privé de l'aéroport à l'hôtel"
  durationHours Int? // Durée de l'activité (ne doit pas excéder celle du coffret)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// RÉSERVATIONS DE COFFRETS
// ==========================================
model CoffretReservation {
  id        Int    @id @default(autoincrement())
  reference String @unique // Ex: NS-COF-123456

  coffretId Int
  coffret   Coffret @relation(fields: [coffretId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  startDate  DateTime // Date de début d'exécution choisie par le couple
  quantity   Int               @default(1) // Nombre de personnes
  totalPrice Decimal           @db.Decimal(18, 2) // Prix calculé après application des RG
  status     ReservationStatus @default(PENDING) // PENDING, CONFIRMED, PROCESSED, CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ======================================================
// PURCHASE
// ======================================================

model Purchase {
  id         Int            @id @default(autoincrement())
  quantity   Int            @default(1)
  totalPrice Decimal        @db.Decimal(18, 2) // <-- FIXATION DU PRIX A L'ACHAT (Comptabilité figée)
  status     PurchaseStatus @default(PENDING)

  // --- FLUX POLYMORTPHE (Les deux sont optionnels, une ligne contient l'un ou l'autre) ---
  annonceId Int?
  annonce   Annonce? @relation(fields: [annonceId], references: [id], onDelete: SetNull)

  giftId Int?
  gift   Gift? @relation(fields: [giftId], references: [id], onDelete: SetNull)

  // --- ACTEURS ---
  senderId   Int
  sender     User @relation("PurchaseSender", fields: [senderId], references: [id])
  receiverId Int
  receiver   User @relation("PurchaseReceiver", fields: [receiverId], references: [id])

  deliveryAddress   String?
  recipientFullName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  matches   Match[]

  @@index([senderId])
  @@index([receiverId])
}

// ======================================================
// RESERVATION
// ======================================================

model Reservation {
  id        Int    @id @default(autoincrement())
  reference String @unique

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NOUVEAU : Pour le bouton "Envoyer Transport", on stocke l'id du destinataire si c'est pour un proche
  receiverId Int?
  receiver   User? @relation("ReservationReceiver", fields: [receiverId], references: [id], onDelete: SetNull)

  annonceId Int
  annonce   Annonce @relation(fields: [annonceId], references: [id], onDelete: Cascade)

  // Gestion des dates / Horaires
  startDate DateTime // Début hébergement / Date activité / Départ course
  endDate   DateTime? // Optionnel car une course ou une activité n'a pas forcément de date de fin stricte au départ

  totalPrice Decimal?          @db.Decimal(18, 2)
  quantity   Int               @default(1)
  status     ReservationStatus @default(PENDING)

  // Options logistiques (Restaurant / Livraison)
  isDelivery      Boolean @default(false)
  deliveryAddress String?
  deliveryPhone   String?

  // Coordonnées GPS Trajet (Spécifique Transport)
  startLatitude    Decimal? @db.Decimal(10, 7)
  startLongitude   Decimal? @db.Decimal(10, 7)
  endLatitude      Decimal? @db.Decimal(10, 7)
  endLongitude     Decimal? @db.Decimal(10, 7)
  startAddressText String? // Ex: "Ma position Fidjrossè"

  // Sécurité & Audit des Litiges / Annulations
  cancellationDeadline DateTime? // Date limite pour l'annulation gratuite avec remboursement automatique
  litigeReason         String? // Motif écrit si "Signaler un problème" est déclenché
  agentArbitrageNote   String? // Note de l'agent IT/ADMIN résolvant le litige

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ======================================================
// LIKES
// ======================================================

model LikedAnnonce {
  id        Int     @id @default(autoincrement())
  userId    Int
  annonceId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  annonce   Annonce @relation(fields: [annonceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, annonceId])
}

// ======================================================
// DM LIST
// ======================================================

model DmList {
  id        Int     @id @default(autoincrement())
  userId    Int
  annonceId Int
  user      User    @relation(fields: [userId], references: [id])
  annonce   Annonce @relation(fields: [annonceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// SOCKET
// ======================================================

model SocketMapping {
  id       Int    @id @default(autoincrement())
  socketId String @unique
  userId   Int    @unique
  user     User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ======================================================
// LOCKED CONVERSATION
// ======================================================

model LockedConversation {
  id          Int      @id @default(autoincrement())
  initiatorId Int
  receiverId  Int
  initiator   User     @relation("InitiatedLocks", fields: [initiatorId], references: [id])
  receiver    User     @relation("ReceivedLocks", fields: [receiverId], references: [id])
  isConfirmed Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([initiatorId, receiverId])
}

// ======================================================
// PODIUM
// ======================================================

model Podium {
  id        Int            @id @default(autoincrement())
  country   String // Code pays (ex: "BJ", "FR")
  status    PodiumStatus   @default(ACTIVE)
  category  PodiumCategory @default(COUNTRY)
  createdAt DateTime       @default(now())

  // Un contexte de podium parent englobe l'historique ou la session de ses sous-groupes (spots)
  stars PodiumStar[]
}

model PodiumStar {
  id       Int    @id @default(autoincrement())
  podiumId Int
  podium   Podium @relation(fields: [podiumId], references: [id], onDelete: Cascade)

  userId Int // ID de la Star actuelle (User)
  user   User @relation("UserAsPodiumStar", fields: [userId], references: [id], onDelete: Cascade)

  spot      Int      @default(1) // Index du sous-groupe (Podium 1, Podium 2...) si N > 100 spectateurs
  timeDue   DateTime // Fin du round (now + 5 minutes)
  country   String // Copie pratique du code pays en majuscules (ex: "BJ")
  levelUsed Int      @default(1) // Niveau algorithmique d'éligibilité (1, 2, 3 ou 4)
  isActive  Boolean  @default(true) // Faux si interruption prématurée (Match / Bouton Danielle)
  createdAt DateTime @default(now())

  spectators PodiumSpectator[]

  @@index([country, isActive])
}

model PodiumSpectator {
  id           Int        @id @default(autoincrement())
  podiumStarId Int
  podiumStar   PodiumStar @relation(fields: [podiumStarId], references: [id], onDelete: Cascade)

  userId Int // ID du spectateur connecté (User)
  user   User @relation("UserAsPodiumSpectator", fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([podiumStarId, userId]) // Garantit qu'un spectateur n'est présent qu'une fois par salon
}

model PodiumTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spotPrice Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())
}

model StarOfTheDay {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  totalAmount Decimal  @db.Decimal(18, 2)
  updatedAt   DateTime @updatedAt
}

model StarOfTheMonth {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  totalAmount Decimal  @db.Decimal(18, 2)
  updatedAt   DateTime @updatedAt
}

model StarOfTheYear {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  totalAmount Decimal  @db.Decimal(18, 2)
  updatedAt   DateTime @updatedAt
}

// ======================================================
// COUNTRY / CITY
// ======================================================

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// SUBSCRIPTION
// ======================================================

model Subscription {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  type        SubscriptionType
  price       Decimal          @db.Decimal(18, 2)

  subscriptions CompanySubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// COMPANY
// ======================================================

model Company {
  id            Int             @id @default(autoincrement())
  name          String?
  phoneNumber   String          @unique
  username      String?         @unique
  email         String?         @unique
  category      CompanyCategory @default(OTHER)
  logo          String?
  bannerPicture String?
  description   String?
  country       String?
  city          String?
  latitude      Decimal?        @db.Decimal(10, 7)
  longitude     Decimal?        @db.Decimal(10, 7)
  mapAddress    String?
  numeroSocial  String?
  balance       Decimal         @default(0) @db.Decimal(18, 2)

  links Json?

  isVerified          Boolean               @default(false)
  isSurplaceAvailable Boolean               @default(true)
  status              String?
  subscriptions       CompanySubscription[]
  annonces            Annonce[]
  gifts               Gift[]
  retraits            Retrait[]
  userCompanies       UserCompany[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  coffrets  Coffret[]
}

// ======================================================
// USER COMPANY
// ======================================================

model UserCompany {
  id        Int     @id @default(autoincrement())
  userId    Int
  companyId Int
  category  String?

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
}

// ======================================================
// COMPANY SUBSCRIPTION
// ======================================================

model CompanySubscription {
  id             Int @id @default(autoincrement())
  companyId      Int
  subscriptionId Int

  company      Company      @relation(fields: [companyId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// ACCOUNT DELETE
// ======================================================

model AccountDelete {
  id          Int      @id @default(autoincrement())
  userId      Int
  description String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}

// ======================================================
// RETRAIT
// ======================================================

model Retrait {
  id        Int           @id @default(autoincrement())
  companyId Int
  company   Company       @relation(fields: [companyId], references: [id])
  amount    Decimal       @db.Decimal(18, 2)
  reference String?       @unique
  status    RetraitStatus @default(PENDING)
  comment   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// ======================================================
// USER BLOCK
// ======================================================

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// ======================================================
// USER REPORT
// ======================================================

model UserReport {
  id          Int          @id @default(autoincrement())
  reporterId  Int
  reportedId  Int
  reporter    User         @relation("Reporter", fields: [reporterId], references: [id])
  reported    User         @relation("Reported", fields: [reportedId], references: [id])
  reason      String
  description String?
  status      ReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// RECHARGE TRANCHES
// ======================================================

model WalletTranche {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  trancheId String      @unique // Identifiant unique métier (TRX-..., DEB-..., REF-...)
  type      TrancheType @default(RECHARGE)

  // SOLDE PRINCIPAL (Argent réel)
  principalInitial Decimal @db.Decimal(18, 2)
  principalRestant Decimal @db.Decimal(18, 2)

  // SOLDE BONUS (Conditionnel)
  bonusTotal    Decimal @db.Decimal(18, 2) // Total généré à la recharge
  bonusDebloque Decimal @default(0) @db.Decimal(18, 2) // Bonus disponible à l'utilisation
  bonusBloque   Decimal @default(0) @db.Decimal(18, 2) // Bonus gelé/séquestré (Ajustements/Sécurité)
  bonusRestant  Decimal @db.Decimal(18, 2) // Bonus encore verrouillé (Au prorata)

  // MÉTA-DONNÉES
  currency      String        @default("XOF")
  statut        TrancheStatus @default(ACTIVE)
  description   String? // Libellé de l'opération pour l'historique UI
  referenceGate String?       @unique // Référence externe Stripe / KKiaPay

  dateRecharge DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([statut])
  @@index([dateRecharge])
}

// ======================================================
// STARPOINTS WALLET
// ======================================================

model StarpointWallet {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  points    Decimal  @default(0) @db.Decimal(18, 2)
  updatedAt DateTime @updatedAt
}

model EnvelopeWheel {
  id          Int              @id @default(autoincrement())
  type        EnvelopeType     @default(DAILY) // On conserve DAILY pour la compatibilité
  prizeAmount Float // Montant dynamique calculé (0.2% du CAH)
  country     String // Code pays en majuscules (ex: "BJ")
  isActive    Boolean          @default(true) // Faux dès qu'un gagnant remporte l'enveloppe de cette heure
  hourStart   DateTime // Heure fixe concernée par cette session de roulette
  cahAmount   Decimal          @default(0) @db.Decimal(18, 2) // CA total cumulé sur l'heure précédente
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  winners     EnvelopeWinner[]

  @@unique([country, hourStart])
  @@index([type, country, isActive])
}

model EnvelopeWinner {
  id              Int           @id @default(autoincrement())
  envelopeWheelId Int
  envelopeWheel   EnvelopeWheel @relation(fields: [envelopeWheelId], references: [id])
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  amountWon       Float
  drawnAt         DateTime      @default(now())
  city            String? // Pour la notification push nationale ("Un utilisateur de [ville]...")

  @@index([drawnAt])
}

model UserEnvelopeMetric {
  id              Int      @id @default(autoincrement())
  userId          Int
  country         String   @db.VarChar(5)
  hourStart       DateTime // Début de l'heure fixe concernée (ex: 12:00:00)
  activeSeconds   Int      @default(0) // Temps cumulé en ligne sur l'heure (max 3600)
  spentAmount     Decimal  @default(0) @db.Decimal(18, 2) // Somme dépensée sur l'heure
  hasSpun         Boolean  @default(false) // Si l'utilisateur a cliqué sur la roue pour cette heure
  lastHeartbeatAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hourStart])
}

model CountryProfitability {
  id                     Int      @id @default(autoincrement())
  countryCode            String   @unique // Code pays en majuscules (ex: "BJ")
  profitabilityThreshold Decimal  @db.Decimal(18, 2) // Seuil défini par le Manager
  currentVolume          Decimal  @default(0) @db.Decimal(18, 2) // Compteur glissant incrémenté par debitWallet
  updatedAt              DateTime @updatedAt
}
